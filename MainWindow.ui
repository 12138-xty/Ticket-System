  <property name="styleSheet">
   <string>
				 {
				background-color: #f8f9fa;
				font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;;
				color: #212529; /* 添加默认字体颜色 */
				}
				QWidget {
				background-color: #ffffff;
				color: #212529; /* 添加默认字体颜色 */
				}
				QGroupBox {
				font-weight: bold;
				border: 1px solid #dee2e6;
				border-radius: 6px;
				margin-top: 10px;
				padding-top: 15px;
				background-color: white;
				color: #212529; /* 添加字体颜色 */
				}
				QGroupBox::title {
				subcontrol-origin: margin;
				left: 10px;
				padding: 0 5px 0 5px;
				color: #495057;
				}
				QPushButton {
				background-color: #007bff;
				color: white;
				border: none;
				border-radius: 6px;
				padding: 10px 16px;
				font-size: 14px;
				font-weight: 500;
				}
				QPushButton:hover {
				background-color: #0056b3;
				}
				QPushButton:pressed {
				background-color: #004085;
				}
				QPushButton:disabled {
				background-color: #6c757d;
				color: #ced4da;
				}
				QListWidget {
				background-color: white;
				border: 1px solid #dee2e6;
				border-radius: 6px;
				padding: 4px;
				color: #212529; /* 添加字体颜色 */
				}
				QListWidget::item {
				padding: 8px;
				border-bottom: 1px solid #e9ecef;
				color: #212529; /* 添加字体颜色 */
				}
				QListWidget::item:selected {
				background-color: #cce5ff;
				color: #004085;
				}
				QListWidget::item:hover {
				background-color: #e9ecef;
				}
				QTableWidget {
				background-color: white;
				border: 1px solid #dee2e6;
				border-radius: 6px;
				gridline-color: #dee2e6;
				selection-background-color: #cce5ff;
				color: #212529; /* 添加字体颜色 */
				}
				QTableWidget::item:selected {
				background-color: #cce5ff;
				color: #212529; /* 添加字体颜色 */
				}
				QHeaderView::section {
				background-color: #e9ecef;
				padding: 8px;
				border: none;
				font-weight: 600;
				color: #495057;
				}
				QLineEdit, QComboBox, QDateEdit {
				border: 1px solid #ced4da;
				border-radius: 4px;
				padding: 6px;
				background-color: white;
				min-height: 25px;
				color: #212529; /* 添加字体颜色 */
				}
				QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
				border-color: #80bdff;
				outline: none;
				}
				QTabWidget::pane {
				border: 1px solid #dee2e6;
				border-radius: 6px;
				background: white;
				margin-top: 10px;
				}
				QTabBar::tab {
				background: #e9ecef;
				border: 1px solid #dee2e6;
				padding: 8px 16px;
				margin-right: 2px;
				border-top-left-radius: 4px;
				border-top-right-radius: 4px;
				color: #495057;
				}
				QTabBar::tab:selected {
				background: white;
				border-bottom-color: white;
				color: #007bff;
				}
				QTabBar::tab:hover {
				background: #dee2e6;
				}
				QLabel {
				color: #212529; /* 确保所有标签都有正确的字体颜色 */
				}
				QLabel#titleLabel {
				font-size: 18px;
				font-weight: bold;
				color: #212529;
				padding: 10px 0;
				}
				QLabel#userNameLabel {
				font-size: 16px;
				font-weight: bold;
				color: #212529;
				}
				QLabel#userTypeLabel {
				font-size: 14px;
				color: #6c757d;
				}
				QStatusBar {
				background-color: #e9ecef;
				color: #495057;
				border-top: 1px solid #dee2e6;
				}
			</string>
  </property>
