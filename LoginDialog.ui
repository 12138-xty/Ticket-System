<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
	<class>LoginDialog</class>
	<widget class="QDialog" name="LoginDialog">
		<property name="geometry">
			<rect>
				<x>0</x>
				<y>0</y>
				<width>400</width>
				<height>380</height>
			</rect>
		</property>
		<property name="minimumSize">
			<size>
				<width>400</width>
				<height>380</height>
			</size>
		</property>
		<property name="windowTitle">
			<string>铁路票务系统 - 用户登录</string>
		</property>
		<property name="styleSheet">
			<string>
				QDialog {
				background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
				stop: 0 #667eea, stop: 1 #764ba2);
				font-family: "Microsoft YaHei", "Segoe UI";
				}
				QFrame#loginFrame {
				background-color: white;
				border-radius: 10px;
				padding: 20px;
				}
				QLabel#titleLabel {
				font-size: 24px;
				font-weight: bold;
				color: #2d3748;
				padding: 10px;
				}
				QLabel {
				color: #4a5568;
				font-weight: 500;
				}
				QLabel#colorHintLabel {
				font-size: 12px;
				color: #718096;
				margin-top: 5px;
				}
				QLineEdit {
				padding: 12px;
				border: 2px solid #e2e8f0;
				border-radius: 6px;
				background-color: #f7fafc;
				font-size: 14px;
				selection-background-color: #4299e1;
				}
				QLineEdit:focus {
				border-color: #4299e1;
				background-color: white;
				}
				QLineEdit#passwordEdit {
				font-family: "Courier New";
				}
				QPushButton {
				padding: 12px;
				border: none;
				border-radius: 6px;
				font-weight: 600;
				font-size: 14px;
				margin: 5px 0;
				color: white;
				}
				/* 蓝色按钮：登录功能 - 补充功能说明文字样式 */
				QPushButton#loginButton {
				background-color: #4299e1;
				}
				QPushButton#loginButton:hover {
				background-color: #3182ce;
				}
				QPushButton#loginButton:pressed {
				background-color: #2b6cb0;
				}
				/* 绿色按钮：注册功能 - 补充功能说明文字样式 */
				QPushButton#registerButton {
				background-color: #48bb78;
				}
				QPushButton#registerButton:hover {
				background-color: #38a169;
				}
				/* 红色按钮：退出功能 - 补充功能说明文字样式 */
				QPushButton#exitButton {
				background-color: #f56565;
				}
				QPushButton#exitButton:hover {
				background-color: #e53e3e;
				}
				QCheckBox {
				color: #4a5568;
				spacing: 8px;
				}
				QCheckBox::indicator {
				width: 16px;
				height: 16px;
				border: 2px solid #cbd5e0;
				border-radius: 3px;
				}
				QCheckBox::indicator:checked {
				background-color: #4299e1;
				border-color: #4299e1;
				}
				QCheckBox::indicator:checked:hover {
				background-color: #3182ce;
				border-color: #3182ce;
				}
			</string>
		</property>
		<layout class="QVBoxLayout" name="mainLayout">
			<item>
				<spacer name="topSpacer">
					<property name="orientation">
						<enum>Qt::Vertical</enum>
					</property>
					<property name="sizeHint" stdset="0">
						<size>
							<width>20</width>
							<height>40</height>
						</size>
					</property>
				</spacer>
			</item>
			<item>
				<widget class="QFrame" name="loginFrame">
					<property name="objectName">
						<string>loginFrame</string>
					</property>
					<property name="frameShape">
						<enum>QFrame::StyledPanel</enum>
					</property>
					<property name="frameShadow">
						<enum>QFrame::Raised</enum>
					</property>
					<layout class="QVBoxLayout" name="frameLayout">
						<item>
							<widget class="QLabel" name="titleLabel">
								<property name="text">
									<string>🚄 用户登录</string>
								</property>
								<property name="alignment">
									<set>Qt::AlignCenter</set>
								</property>
								<property name="objectName">
									<string>titleLabel</string>
								</property>
							</widget>
						</item>
						<item>
							<spacer name="titleSpacer">
								<property name="orientation">
									<enum>Qt::Vertical</enum>
								</property>
								<property name="sizeHint" stdset="0">
									<size>
										<width>20</width>
										<height>20</height>
									</size>
								</property>
							</spacer>
						</item>
						<item>
							<layout class="QFormLayout" name="formLayout">
								<item row="0" column="0">
									<widget class="QLabel" name="usernameLabel">
										<property name="text">
											<string>👤 用户名：</string>
										</property>
									</widget>
								</item>
								<item row="0" column="1">
									<widget class="QLineEdit" name="usernameEdit">
										<property name="placeholderText">
											<string>请输入用户ID</string>
										</property>
										<property name="clearButtonEnabled">
											<bool>true</bool>
										</property>
									</widget>
								</item>
								<item row="1" column="0">
									<widget class="QLabel" name="passwordLabel">
										<property name="text">
											<string>🔒 密码：</string>
										</property>
									</widget>
								</item>
								<item row="1" column="1">
									<widget class="QLineEdit" name="passwordEdit">
										<property name="echoMode">
											<enum>QLineEdit::Password</enum>
										</property>
										<property name="placeholderText">
											<string>请输入密码</string>
										</property>
										<property name="objectName">
											<string>passwordEdit</string>
										</property>
									</widget>
								</item>
							</layout>
						</item>
						<item>
							<widget class="QCheckBox" name="rememberCheckBox">
								<property name="text">
									<string>记住密码</string>
								</property>
								<property name="checked">
									<bool>false</bool>
								</property>
							</widget>
						</item>
						<!-- 新增颜色含义提示标签：明确告知用户不同颜色按钮的功能 -->
						<item>
							<widget class="QLabel" name="colorHintLabel">
								<property name="text">
									<string>🔵 蓝色=登录系统 | 🟢 绿色=注册账号 | 🔴 红色=退出程序</string>
								</property>
								<property name="objectName">
									<string>colorHintLabel</string>
								</property>
								<property name="alignment">
									<set>Qt::AlignCenter</set>
								</property>
							</widget>
						</item>
						<item>
							<spacer name="formSpacer">
								<property name="orientation">
									<enum>Qt::Vertical</enum>
								</property>
								<property name="sizeHint" stdset="0">
									<size>
										<width>20</width>
										<height>15</height>
									</size>
								</property>
							</spacer>
						</item>
						<item>
							<layout class="QVBoxLayout" name="buttonLayout">
								<!-- 蓝色按钮：登录 - 按钮文本保留图标+文字，强化识别 -->
								<item>
									<widget class="QPushButton" name="loginButton">
										<property name="text">
											<string>🔵 登录系统</string>
										</property>
										<property name="objectName">
											<string>loginButton</string>
										</property>
										<property name="default">
											<bool>true</bool>
										</property>
									</widget>
								</item>
								<!-- 绿色按钮：注册 - 按钮文本保留图标+文字，强化识别 -->
								<item>
									<widget class="QPushButton" name="registerButton">
										<property name="text">
											<string>🟢 注册新用户</string>
										</property>
										<property name="objectName">
											<string>registerButton</string>
										</property>
									</widget>
								</item>
								<!-- 红色按钮：退出 - 按钮文本保留图标+文字，强化识别 -->
								<item>
									<widget class="QPushButton" name="exitButton">
										<property name="text">
											<string>🔴 退出系统</string>
										</property>
										<property name="objectName">
											<string>exitButton</string>
										</property>
									</widget>
								</item>
							</layout>
						</item>
					</layout>
				</widget>
			</item>
			<item>
				<spacer name="bottomSpacer">
					<property name="orientation">
						<enum>Qt::Vertical</enum>
					</property>
					<property name="sizeHint" stdset="0">
						<size>
							<width>20</width>
