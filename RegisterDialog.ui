		<property name="styleSheet">
			<string>
				QDialog {
				background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
				stop: 0 #4facfe, stop: 1 #00f2fe);
				font-family: "Microsoft YaHei", "Segoe UI";
				}
				QScrollArea {
				border: none;
				background: transparent;
				}
				QScrollArea > QWidget > QWidget {
				background: transparent;
				}
				QFrame#registerFrame {
				background-color: white;
				border-radius: 12px;
				padding: 25px;
				margin: 20px;
				}
				QLabel {
				color: #2d3748;
				font-weight: 500;
				font-size: 14px;
				}
				QLabel#titleLabel {
				font-size: 22px;
				font-weight: bold;
				color: #2d3748;
				padding: 10px;
				}
				QLineEdit {
				padding: 12px;
				border: 2px solid #e2e8f0;
				border-radius: 6px;
				background-color: #f7fafc;
				font-size: 14px;
				selection-background-color: #4299e1;
				}
				QLineEdit:focus {
				border-color: #4299e1;
				background-color: white;
				}
				QLineEdit:placeholder {
				color: #a0aec0;
				}
				QLineEdit[isValid="false"] {
				border-color: #f56565;
				background-color: #fed7d7;
				}
				QLineEdit[isValid="true"] {
				border-color: #48bb78;
				}
				QPushButton {
				padding: 12px 20px;
				border: none;
				border-radius: 6px;
				font-weight: 600;
				font-size: 14px;
				margin: 5px;
				}
				QPushButton#registerBtn {
				background-color: #48bb78;
				color: white;
				}
				QPushButton#registerBtn:hover {
				background-color: #38a169;
				}
				QPushButton#registerBtn:pressed {
				background-color: #2f855a;
				}
				QPushButton#registerBtn:disabled {
				background-color: #a0aec0;
				color: #e2e8f0;
				}
				QPushButton#cancelBtn {
				background-color: #718096;
				color: white;
				}
				QPushButton#cancelBtn:hover {
				background-color: #4a5568;
				}
				QCheckBox {
				color: #4a5568;
				spacing: 8px;
				font-size: 13px;
				}
				QCheckBox::indicator {
				width: 16px;
				height: 16px;
				border: 2px solid #cbd5e0;
				border-radius: 3px;
				}
				QCheckBox::indicator:checked {
				background-color: #4299e1;
				border-color: #4299e1;
				}
				.validationIcon {
				color: #e53e3e;
				font-weight: bold;
				}
				.validationIcon.valid {
				color: #38a169;
				}
			</string>
		</property>
